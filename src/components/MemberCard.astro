---
// ⛔ DO NOT EDIT for routine content updates.
// Renders a single member card. Data comes from src/data/members.yaml.

import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'members'>;
}
const { member } = Astro.props;
const d = member.data;

// Fallback: when no photo is provided, show name initials in a soft lime circle.
const initials = d.name
  .replace(/[··]/g, ' ')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((s) => s[0]?.toUpperCase() ?? '')
  .join('');

// Render inline Markdown links in the work field: [text](url) → anchor tag.
function escapeAttr(s: string) {
  return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
}
function renderInline(text: string) {
  return text.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, label, url) => {
    return `<a href="${escapeAttr(url)}" target="_blank" rel="noopener" class="link-subtle">${label}</a>`;
  });
}
const workHtml = d.work ? renderInline(d.work) : '';
---
<article class:list={['card relative flex h-full flex-col items-center p-6 text-center', d.url && 'group']}>
  {d.photo ? (
    <img
      src={d.photo}
      alt={d.name}
      loading="lazy"
      class="h-32 w-32 rounded-full object-cover ring-2 ring-ink-100 transition-all duration-300 group-hover:ring-lime-300"
    />
  ) : (
    <div class="flex h-32 w-32 items-center justify-center rounded-full bg-lime-100 text-2xl font-semibold text-lime-800 ring-2 ring-ink-100 transition-all duration-300 group-hover:ring-lime-300">
      {initials || '?'}
    </div>
  )}
  <h3 class="mt-4 text-base font-semibold text-ink-950">
    {d.url ? (
      <a href={d.url} target="_blank" rel="noopener" class="link-subtle after:absolute after:inset-0 after:content-['']">{d.name}</a>
    ) : (
      d.name
    )}
  </h3>
  {d.period && <p class="copy-support mt-1 text-ink-500">{d.period}</p>}
  {d.research && (
    <p class="copy-support mt-3 text-ink-700">{d.research}</p>
  )}
  {d.work && (
    <p class="copy-support relative z-10 mt-2 text-ink-600" set:html={workHtml} />
  )}
  {d.coAdvisor && (
    <p class="copy-support relative z-10 mt-3 text-ink-500">
      Co-advised with{' '}
      {d.coAdvisor.url ? (
        <a href={d.coAdvisor.url} class="link-accent" target="_blank" rel="noopener">{d.coAdvisor.name}</a>
      ) : (
        <span>{d.coAdvisor.name}</span>
      )}
    </p>
  )}
</article>
