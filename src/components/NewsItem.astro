---
// ⛔ DO NOT EDIT for routine content updates.
// Renders a single news item. Data comes from src/data/news.yaml.
// Inline links: use `[text](url)` Markdown syntax in the title field.

import type { CollectionEntry } from 'astro:content';
import { markAwardHtml } from '../lib/award';

interface Props {
  item: CollectionEntry<'news'>;
  compact?: boolean;
}
const { item, compact = false } = Astro.props;
const d = item.data;

// Soft filled tag, 4px corners, no outline (same style as the PI site's talk tags).
const tagStyles: Record<string, string> = {
  paper: 'bg-lime-100 text-lime-800',
  award: 'bg-lemon-100 text-lemon-900',
  talk: 'bg-blue-100 text-blue-800',
  media: 'bg-purple-100 text-purple-800',
  team: 'bg-pink-100 text-pink-800',
  release: 'bg-indigo-100 text-indigo-800',
};
const tagClass = tagStyles[d.tag] ?? tagStyles.paper;

// Render Markdown-style inline links: [text](url) → <a href="url">text</a>
function escapeAttr(s: string) {
  return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
}
function renderInline(text: string) {
  return text.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, label, url) => {
    return `<a href="${escapeAttr(url)}" target="_blank" rel="noopener" class="link-subtle">${label}</a>`;
  });
}
const titleHtml = markAwardHtml(renderInline(d.title));

const itemClass = compact
  ? 'group relative grid grid-cols-[auto_1fr] gap-3 py-2.5 first:pt-0 last:pb-0'
  : 'group relative grid grid-cols-[auto_1fr] gap-4 py-4 first:pt-0 last:pb-0';
const textClass = 'copy-dense text-ink-800';
---
<li class={itemClass}>
  <div class="flex flex-col items-start gap-1">
    <time class="text-xs text-ink-500">{d.date}</time>
    <span class={`inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${tagClass}`}>
      {d.tag}
    </span>
  </div>
  <p class={textClass}>
    <span set:html={titleHtml} />
  </p>
</li>
