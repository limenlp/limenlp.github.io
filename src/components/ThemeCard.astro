---
// ⛔ DO NOT EDIT for routine content updates.
// Renders a research theme card. Data comes from src/data/themes.yaml.
// To ADD A NEW ICON option, edit the `icons` map in this file (paste a Lucide SVG path).

import type { CollectionEntry } from 'astro:content';

interface Props {
  theme: CollectionEntry<'themes'>;
  count: number;
  slug: string;
}
const { theme, count, slug } = Astro.props;
const d = theme.data;

// Icon paths (Lucide-style)
const icons: Record<string, string> = {
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  cursor: '<path d="M14 4.1 12 6"/><path d="m5.1 8-2.9-.8"/><path d="m6 12-1.9 2"/><path d="M7.2 2.2 8 5.1"/><path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"/>',
  compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  scale: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
};
const iconPath = d.icon ? icons[d.icon] : null;
---
<a href={`/papers/?theme=${slug}`} class="card group flex h-full flex-col p-6">
  <div class="flex items-center gap-3">
    {iconPath && (
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-lime-50 text-lime-700 ring-1 ring-inset ring-lime-200 transition-colors group-hover:bg-lime-100 group-hover:text-lime-800">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPath}></svg>
      </span>
    )}
    <h3 class="text-lg font-semibold text-ink-950 transition-colors group-hover:text-lime-700">{d.name}</h3>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-ink-700">{d.blurb}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-lime-700">
    Explore
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </span>
</a>
