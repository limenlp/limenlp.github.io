---
import type { CollectionEntry } from 'astro:content';

interface Props {
  pi: CollectionEntry<'members'>;
}
const { pi } = Astro.props;
const d = pi.data;
const social = d.social;
---
<section class="grid gap-8 rounded-3xl border border-ink-100 bg-white p-8 md:grid-cols-[auto_1fr] md:p-10">
  <div class="flex flex-col items-center md:items-start">
    <a href={d.url} class="group" target="_blank" rel="noopener">
      <img
        src={d.photo}
        alt={d.name}
        class="h-44 w-44 rounded-full object-cover ring-2 ring-ink-100 transition-all duration-300 group-hover:ring-lime-300"
      />
    </a>
  </div>
  <div class="flex flex-col gap-3">
    <span class="eyebrow">Principal Investigator</span>
    <h2 class="heading-2">
      <a href={d.url} class="hover:text-lime-700" target="_blank" rel="noopener">{d.name}</a>
    </h2>
    {d.research && <p class="text-base leading-relaxed text-ink-700">{d.research}</p>}
    {social && (
      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        {social.scholar && <a href={social.scholar} target="_blank" rel="noopener" class="link-accent">Scholar</a>}
        {social.twitter && <a href={social.twitter} target="_blank" rel="noopener" class="link-accent">Twitter</a>}
        {social.github && <a href={social.github} target="_blank" rel="noopener" class="link-accent">GitHub</a>}
        {social.linkedin && <a href={social.linkedin} target="_blank" rel="noopener" class="link-accent">LinkedIn</a>}
        {social.orcid && <a href={social.orcid} target="_blank" rel="noopener" class="link-accent">ORCID</a>}
        {social.email && <a href={`mailto:${social.email}`} class="link-accent">Email</a>}
      </div>
    )}
  </div>
</section>
