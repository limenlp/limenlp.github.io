---
// ⛔ DO NOT EDIT for routine content updates.
// /news/ archive page template. For content updates, edit src/data/news.yaml.

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsItem from '../components/NewsItem.astro';

const all = await getCollection('news');
const sorted = all.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

// Group by year, then by year-month.
const byYear: Record<string, typeof sorted> = {};
for (const item of sorted) {
  const year = item.data.date.slice(0, 4);
  byYear[year] = byYear[year] ?? [];
  byYear[year].push(item);
}
const years = Object.keys(byYear).sort((a, b) => b.localeCompare(a));
---
<Base title="News · LIME Lab" description="News and announcements from LIME Lab.">
  <section class="container-prose pt-8 sm:pt-12">
    <h1 class="heading-1">News</h1>
    <p class="mt-6 max-w-3xl text-lg text-ink-500">
      Paper acceptances, awards, talks, and lab milestones.
    </p>
  </section>

  <div class="container-prose mt-8 space-y-10">
    {years.map((year) => (
      <section>
        <div class="mb-3 flex items-baseline gap-3">
          <h2 class="text-xl font-semibold text-ink-950 underline decoration-lemon-400 decoration-4 underline-offset-4">{year}</h2>
          <div class="h-px flex-1 bg-ink-100"></div>
          <span class="text-xs text-ink-500">{byYear[year].length} {byYear[year].length === 1 ? 'item' : 'items'}</span>
        </div>
        <ul class="divide-y divide-ink-100">
          {byYear[year].map((item) => <NewsItem item={item} compact />)}
        </ul>
      </section>
    ))}
  </div>
</Base>
