---
// ⛔ DO NOT EDIT for routine content updates.
// Home page template. For content updates, edit src/data/*.yaml (news, papers,
// awards, themes, press, sponsors, members) — this template just renders them.

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NewsItem from '../components/NewsItem.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import PaperCard from '../components/PaperCard.astro';
import ThemeCard from '../components/ThemeCard.astro';
import g1Logo from '../assets/g1.png';
import limeMoments from '../assets/lime-moments.jpg';

const allPapers = await getCollection('papers');
const allThemes = await getCollection('themes');
const allNews = await getCollection('news');
const allAwards = await getCollection('awards');
const allPress = await getCollection('press');
const allSponsors = await getCollection('sponsors');

const spotlightPapers = allPapers.filter((p) => p.data.spotlight).sort((a, b) => b.data.year - a.data.year);
const featuredPapers = allPapers.filter((p) => p.data.featured).sort((a, b) => b.data.year - a.data.year);
const spotlight = [...spotlightPapers, ...featuredPapers]
  .filter((p, i, arr) => arr.findIndex((x) => x.id === p.id) === i)
  .slice(0, 5);

const news = allNews
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 10);

const themesIntro = allThemes.find((t) => t.data.intro)?.data.intro ?? '';
const themesSorted = allThemes
  .filter((t) => !t.data.intro)
  .sort((a, b) => a.data.order - b.data.order);
const themeCounts: Record<string, number> = {};
for (const p of allPapers) {
  for (const t of p.data.themes) {
    themeCounts[t] = (themeCounts[t] ?? 0) + 1;
  }
}

const awards = allAwards.sort((a, b) => b.data.year - a.data.year);
const sponsors = allSponsors.sort((a, b) => a.data.order - b.data.order);
const pressItems = allPress;
---
<Base title="LIME Lab" description="LIME Lab works on modeling and evaluating AI models and agents. Led by Prof. Jieyu Zhao at USC.">
  <!-- HERO -->
  <section class="container-prose pt-8 sm:pt-12">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <Image
            src={g1Logo}
            alt="LIME Lab logo"
            widths={[112, 224]}
            sizes="(min-width: 768px) 112px, (min-width: 640px) 96px, 80px"
            class="h-20 w-20 shrink-0 object-contain drop-shadow-sm sm:h-24 sm:w-24 md:h-28 md:w-28"
          />
          <span class="eyebrow !text-base sm:!text-lg underline decoration-lemon-400 decoration-2 underline-offset-4">Language · Intelligence · Modeling · Evaluation</span>
        </div>
        <h1 class="heading-1">
          Building trustworthy AI
          <span class="block">— by people who <span class="relative inline-block">
            <span class="relative z-10 text-lime-700">actually check.</span>
            <span class="absolute inset-x-0 bottom-1 -z-0 h-3 bg-lemon-300/90"></span>
          </span></span>
        </h1>
        <p class="max-w-3xl text-lg leading-relaxed text-ink-700">
          LIME Lab is part of the <a href="https://nlp.usc.edu/" target="_blank" rel="noopener" class="link-accent">USC NLP Group</a>, led by <a href="https://jieyuzhao.github.io" target="_blank" rel="noopener" class="link-accent">Prof. Jieyu Zhao</a>. We work on two sides of AI models and agents — <strong class="font-semibold text-ink-900">modeling</strong> them to be more capable, aligned, and reliable in the real world, and designing <strong class="font-semibold text-ink-900">evaluations</strong> that surface where they fall short, with a strong <strong class="font-semibold text-ink-900">human-centered</strong> thread throughout.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/papers/" class="inline-flex items-center gap-2 rounded-full bg-ink-950 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-lime-700">
            Read our papers
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/wiki/" class="inline-flex items-center gap-2 rounded-full border border-ink-300 bg-ink-50 px-5 py-2.5 text-sm font-medium text-ink-800 transition-colors hover:border-lime-400 hover:bg-lime-50 hover:text-lime-800">
            Group Wiki
          </a>
          <a href="https://forms.gle/9JUCn2C5zLhmLCZ18" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-lemon-300 px-5 py-2.5 text-sm font-semibold text-lime-900 ring-1 ring-inset ring-lemon-400 transition-colors hover:bg-lemon-400">
            We're hiring →
          </a>
        </div>
      </div>
      <div class="hidden md:flex md:flex-col md:items-center">
        <figure class="relative">
          <div class="absolute -inset-6 -z-10 rounded-3xl bg-gradient-to-br from-lime-100/60 to-transparent blur-2xl"></div>
          <div class="rotate-1 rounded-md bg-white p-3 pb-2 shadow-[0_8px_24px_-12px_rgba(0,0,0,0.25)] ring-1 ring-ink-200/60 transition-transform duration-300 hover:rotate-0">
            <Image
              src={limeMoments}
              alt="LIME moments — AI-generated lab portrait"
              widths={[288, 576]}
              sizes="288px"
              format="webp"
              quality={82}
              class="w-72 rounded-sm"
              loading="lazy"
            />
            <figcaption class="mt-3 text-center text-xs italic text-ink-600">
              Seed Dream 4.0 · prompted by Taiwei Shi
            </figcaption>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- NEWS + SPOTLIGHT (carousel) -->
  <section class="container-prose mt-24 grid gap-10 lg:grid-cols-[2fr_3fr]">
    <div>
      <h2 class="heading-3 mb-6">Latest</h2>
      <ul class="divide-y divide-ink-100">
        {news.map((item) => <NewsItem item={item} />)}
      </ul>
      <a href="/news/" class="group mt-6 inline-flex items-center gap-1 text-sm font-medium text-lime-700 hover:text-persimmon">
        All news
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
    <div class="min-w-0">
      <h2 class="heading-3 mb-6">Spotlight</h2>
      {spotlight.length > 0 && (
        <div class="relative" data-spotlight-carousel>
          <button
            type="button"
            aria-label="Previous spotlight"
            data-carousel-prev
            class="absolute left-3 top-1/2 z-10 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 bg-white/95 text-lime-700 shadow-sm transition hover:border-lime-400 hover:bg-lime-50 hover:text-persimmon"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button
            type="button"
            aria-label="Next spotlight"
            data-carousel-next
            class="absolute right-3 top-1/2 z-10 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 bg-white/95 text-lime-700 shadow-sm transition hover:border-lime-400 hover:bg-lime-50 hover:text-persimmon"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <div data-carousel-track class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {spotlight.map((paper) => (
              <div class="w-full shrink-0 snap-start">
                <SpotlightCard paper={paper} />
              </div>
            ))}
          </div>
          <div data-carousel-dots class="mt-4 flex items-center justify-center gap-2" aria-hidden="true">
            {spotlight.map((_, i) => (
              <button
                type="button"
                data-carousel-dot={i}
                aria-label={`Go to spotlight ${i + 1}`}
                class="h-2 w-2 rounded-full bg-ink-200 transition-all data-[active=true]:w-6 data-[active=true]:bg-lime-600"
                data-active={i === 0 ? 'true' : 'false'}
              ></button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-spotlight-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-carousel-track]');
      const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
      if (!track) return;
      const total = dots.length;
      const slideWidth = () => track.clientWidth;
      const currentIndex = () => Math.round(track.scrollLeft / slideWidth());
      const goTo = (i: number) => {
        const wrapped = ((i % total) + total) % total;
        track.scrollTo({ left: wrapped * slideWidth(), behavior: 'smooth' });
      };
      const updateDots = () => {
        const idx = currentIndex();
        dots.forEach((d, i) => d.setAttribute('data-active', i === idx ? 'true' : 'false'));
      };
      prev?.addEventListener('click', () => goTo(currentIndex() - 1));
      next?.addEventListener('click', () => goTo(currentIndex() + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
      track.addEventListener('scroll', updateDots, { passive: true });
    });
  </script>

  <!-- THEMES -->
  <section class="container-prose mt-24">
    <div class="mb-4 flex items-end justify-between">
      <h2 class="heading-2">Research</h2>
      <a href="/papers/" class="hidden text-sm font-medium text-lime-700 hover:text-lime-800 sm:inline-flex sm:items-center sm:gap-1">All papers →</a>
    </div>
    {themesIntro && (
      <p class="mb-8 text-base leading-relaxed text-ink-700">{themesIntro}</p>
    )}
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {themesSorted.map((theme) => (
        <ThemeCard theme={theme} slug={theme.id} count={themeCounts[theme.id] ?? 0} />
      ))}
    </div>
  </section>

  <!-- AWARDS + PRESS -->
  <section class="container-prose mt-24 grid gap-12 lg:grid-cols-[1fr_1fr]">
    <div>
      <h2 class="heading-3">Awards</h2>
      <ul class="mt-6 divide-y divide-ink-100 border-y border-ink-100">
        {awards.map((a) => (
          <li class="flex items-baseline gap-4 py-3">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-ink-950">
                {a.data.href ? (
                  <a href={a.data.href} target="_blank" rel="noopener" class="link-subtle">{a.data.title}</a>
                ) : (
                  a.data.title
                )}
                {a.data.recipient && (
                  <span class="ml-1.5 inline-flex items-center rounded-full bg-ink-50 px-2 py-0.5 text-[11px] font-medium text-ink-700">
                    {a.data.recipient}
                  </span>
                )}
              </p>
              {a.data.paper && (
                <p class="mt-0.5 text-xs italic text-ink-600">
                  {a.data.href ? (
                    <a href={a.data.href} target="_blank" rel="noopener" class="link-subtle">{a.data.paper}</a>
                  ) : (
                    a.data.paper
                  )}
                </p>
              )}
            </div>
            <span class="shrink-0 text-xs tabular-nums text-ink-500">
              {a.data.year}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="heading-3">Featured In</h2>
      <ul class="mt-6 space-y-3">
        {pressItems.map((p) => (
          <li>
            <a href={p.data.href} target="_blank" rel="noopener" class="card flex items-center justify-between gap-4 p-4">
              <div>
                <p class="text-xs font-medium uppercase tracking-wider text-ink-500">{p.data.outlet}{p.data.year ? ` · ${p.data.year}` : ''}</p>
                {p.data.headline && <p class="mt-1 text-sm font-medium text-ink-900">{p.data.headline}</p>}
              </div>
              <span class="text-ink-400">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SPONSORS -->
  <section class="container-prose mt-24">
    <div class="mb-8 text-center">
      <h2 class="heading-3">Research Sponsors</h2>
    </div>
    <div class="grid grid-cols-2 items-center gap-6 sm:grid-cols-3 md:grid-cols-4">
      {sponsors.map((s) => (
        <div class="flex items-center justify-center rounded-xl border border-ink-100 bg-white p-6">
          <img src={s.data.logo} alt={s.data.name} class="h-12 w-auto max-w-full object-contain" />
        </div>
      ))}
    </div>
  </section>
</Base>
